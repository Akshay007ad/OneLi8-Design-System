{
  "name": "oneli8",
  "private": true,
  "version": "1.0.0-beta.4",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "sync:tokens": "node packages/tokens/scripts/build.mjs --standalone",
    "sync:icons": "node packages/sync/src/build-icons.mjs",
    "test:tokens": "node packages/tokens/scripts/test.mjs --standalone",
    "build": "npm run sync:tokens && npm run sync:styles && npm run sync:icons && npm run sync:context && npm run check",
    "check": "node packages/sync/src/check-structure.mjs && npm run test:tokens",
    "sync:styles": "node packages/sync/src/build-styles.mjs",
    "sync:context": "node packages/sync/src/build-package-context.mjs"
  }
}
