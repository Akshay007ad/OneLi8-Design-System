{
  "name": "@oneli8/core",
  "version": "1.0.0-beta.3",
  "description": "OneLi8 Design System — framework-agnostic components. Renders HTML strings and hydrates existing DOM; no framework required.",
  "keywords": ["design-system", "components", "headless", "framework-agnostic", "design-tokens", "accessibility", "oneli8"],
  "homepage": "https://github.com/Akshay007ad/OneLi8-Design-System#readme",
  "bugs": { "url": "https://github.com/Akshay007ad/OneLi8-Design-System/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akshay007ad/OneLi8-Design-System.git",
    "directory": "packages/core"
  },
  "license": "Apache-2.0",
  "author": "Akshay Dhore",
  "type": "module",
  "exports": {
    ".": { "types": "./src/index.d.ts", "import": "./src/index.js" },
    "./atoms": { "types": "./src/atoms/index.d.ts", "import": "./src/atoms/index.js" },
    "./molecules": { "types": "./src/molecules/index.d.ts", "import": "./src/molecules/index.js" },
    "./organisms": { "types": "./src/organisms/index.d.ts", "import": "./src/organisms/index.js" },
    "./styles.css": "./styles.css",
    "./styles/icon.css": "./src/atoms/icon/icon.css",
    "./styles/selection-indicator.css": "./src/atoms/selection-indicator/selection-indicator.css",
    "./styles/button.css": "./src/molecules/button/button.css",
    "./styles/icon-button.css": "./src/molecules/icon-button/icon-button.css",
    "./styles/choice-item.css": "./src/molecules/choice-item/choice-item.css",
    "./styles/selection-option.css": "./src/molecules/selection-option/selection-option.css",
    "./styles/choice-group.css": "./src/organisms/choice-group/choice-group.css",
    "./styles/gem.css": "./src/materials/gem/gem.css",
    "./package.json": "./package.json"
  },
  "types": "./src/index.d.ts",
  "sideEffects": ["./styles.css", "**/*.css"],
  "files": ["src", "styles.css", "README.md", "LICENSE", "NOTICE"],
  "dependencies": {
    "@oneli8/tokens": "1.0.0-beta.3"
  },
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public", "tag": "beta" }
}
